NODE_ENV=production
PORT=4173
PUBLIC_ORIGIN=https://www.example.com
ALLOWED_ORIGINS=https://www.example.com

STORAGE_MODE=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_ENQUIRIES_TABLE=institutional_enquiries
SUPABASE_EMAIL_TABLE=email_deliveries

AFRICA2060_INTERNAL_EMAIL=operations@example.com
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=Africa 2060 <noreply@example.com>
REQUIRE_EMAIL=true

# Internal API; generate a long random secret and keep it server-side.
ADMIN_API_TOKEN=YOUR_LONG_RANDOM_ADMIN_TOKEN

MAX_BODY_BYTES=32768
RATE_LIMIT_PER_MINUTE=12
RATE_WINDOW_MS=60000

# Optional: local development/test data location. Never use shared/public storage in production.
# DATA_DIR=./data
# ALLOW_LOCAL_STORAGE=true

RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_MS=500
SUPABASE_AUDIT_TABLE=audit_events

# Set true only when the deployment proxy is trusted to supply X-Forwarded-For.
TRUST_PROXY=false

# Optional deployment-level timeout for your platform/load balancer is recommended.
# The application itself times out email-provider requests after 10 seconds.
